# ── Delta Air Lines HelpDesk Bot — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Optional channel/role IDs. A channel ID of 0 uses its exact channel name.
LOUNGE_CHANNEL_ID=0
BOT_COMMANDS_CHANNEL_ID=0
AUTHENTICATED_ROLE_ID=0
ECONOMY_DB_PATH=bot/economy.db
AUDIT_DB_PATH=bot/audit.db
