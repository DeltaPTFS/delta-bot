modules = ["python-3.12", "nodejs-24"]

# Start the Discord bot when the Run button is used. Keeping this command here
# also prevents Replit from guessing that the TypeScript workspace is the app.
run = "python bot/main.py"

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["sh", "-c", "python -m pip install -r requirements.txt"]
run = ["python", "bot/main.py"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
